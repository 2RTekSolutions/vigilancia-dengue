# Copie para .env e preencha. Nunca faça commit do .env.
# Os nomes são os que o psql e o psycopg leem sozinhos.

# Banco PostgreSQL do ETL (container dengue-db no homelab).
# Desktop/notebook, pelo túnel "ssh -N -L 5433:10.114.66.23:5432 homelab": localhost e 5433.
# Container dengue: 10.114.66.23 e 5432.
PGHOST=localhost
PGPORT=5433
PGDATABASE=dengue
PGUSER=dengue_etl
PGPASSWORD=
