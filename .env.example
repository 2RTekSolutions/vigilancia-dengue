# Copie para .env e preencha. Nunca faça commit do .env.
# Os nomes são os que o psql e o psycopg leem sozinhos.

# Banco PostgreSQL do ETL (container dengue-db no homelab).
# <IP do dengue-db>: rode "incus list dengue-db" no homelab ou peça no grupo.
# Desktop/notebook, pelo túnel "ssh -N -L 5433:<IP do dengue-db>:5432 homelab": localhost e 5433.
# Container dengue: <IP do dengue-db> e 5432.
PGHOST=localhost
PGPORT=5433
PGDATABASE=dengue
PGUSER=dengue_etl
PGPASSWORD=
